# Copy this file to ".env" (same folder) and fill in the real values.
# ".env" is gitignored — never commit real project details here, only in this template.
#
# Authentication uses your own Google login (Application Default Credentials),
# not a service account key file — after copying this file, just run:
#   gcloud auth application-default login

GCP_PROJECT_ID=your-project-id-here
GCP_REGION=europe-west4
